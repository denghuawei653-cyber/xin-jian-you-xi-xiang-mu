# ============================================================
# Godot 4 团队协作 .gitattributes
#
# 两大作用：
#   1) 统一换行符，消除"整个文件都变了"的假冲突（团队跨平台时天天遇到）
#   2) 让 Git LFS 接管大体积美术 / 音频 / 3D 资产
#
# ⚠️ LFS 规则必须在文件【第一次入库之前】就写好，
#    否则二进制已经进了普通 git 历史，事后清理极其麻烦。
# ============================================================

# ---------- 1. 换行符默认统一为 LF ----------
* text=auto eol=lf

# ---------- 2. Godot 文本资源强制 LF ----------
# 这些是纯文本，用 LF 才能让人看懂 diff，也才能做三方合并。
*.gd          text eol=lf
*.gdshader    text eol=lf
*.gdshaderinc text eol=lf
*.tscn        text eol=lf
*.tres        text eol=lf
*.godot       text eol=lf
*.cfg         text eol=lf
*.import      text eol=lf
*.uid         text eol=lf
*.json        text eol=lf
*.csv         text eol=lf
*.md          text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.toml        text eol=lf
*.sh          text eol=lf

# Windows 专用脚本保留 CRLF，否则可能双击/执行异常
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# ---------- 3. 场景与资源走文本合并 ----------
# 让 .tscn/.tres 冲突时按文本行去做 diff / 合并，能救回大部分小冲突
*.tscn merge=text
*.tres merge=text

# ---------- 4. 二进制文件：禁止 Git 做任何文本处理 ----------
*.pck   binary
*.exe   binary
*.dll   binary
*.so    binary
*.dylib binary
*.apk   binary
*.aab   binary
*.ipa   binary
*.zip   binary

# ============================================================
# 5. Git LFS —— 大体积美术 / 音频 / 3D 源文件
#
# 不加 LFS 的后果：一次美术更新就把仓库撑大几十 MB，
# 而且历史一旦写进去就永久删不掉，团队 clone 会越来越慢。
#
# lockable = 允许用 `git lfs lock` 上锁，
#   适合 PSD / Blend / FBX 这类"根本无法合并"的文件（见 CONTRIBUTING.md）
# 如果团队不想用锁定机制，删掉后面的 lockable 即可。
# ============================================================

# --- 图片 / 贴图 ---
*.png      filter=lfs diff=lfs merge=lfs -text
*.jpg      filter=lfs diff=lfs merge=lfs -text
*.jpeg     filter=lfs diff=lfs merge=lfs -text
*.gif      filter=lfs diff=lfs merge=lfs -text
*.bmp      filter=lfs diff=lfs merge=lfs -text
*.tga      filter=lfs diff=lfs merge=lfs -text
*.webp     filter=lfs diff=lfs merge=lfs -text
*.exr      filter=lfs diff=lfs merge=lfs -text
*.hdr      filter=lfs diff=lfs merge=lfs -text
*.dds      filter=lfs diff=lfs merge=lfs -text

# --- 美术源文件（不可合并，建议配合 git lfs lock 使用）---
*.psd      filter=lfs diff=lfs merge=lfs -text lockable
*.psb      filter=lfs diff=lfs merge=lfs -text lockable
*.xcf      filter=lfs diff=lfs merge=lfs -text lockable
*.kra      filter=lfs diff=lfs merge=lfs -text lockable
*.aseprite filter=lfs diff=lfs merge=lfs -text lockable
*.ase      filter=lfs diff=lfs merge=lfs -text lockable

# --- 字体 ---
*.ttf      filter=lfs diff=lfs merge=lfs -text
*.otf      filter=lfs diff=lfs merge=lfs -text
*.woff     filter=lfs diff=lfs merge=lfs -text
*.woff2    filter=lfs diff=lfs merge=lfs -text

# --- 音频 ---
*.wav      filter=lfs diff=lfs merge=lfs -text
*.mp3      filter=lfs diff=lfs merge=lfs -text
*.ogg      filter=lfs diff=lfs merge=lfs -text
*.oga      filter=lfs diff=lfs merge=lfs -text
*.flac     filter=lfs diff=lfs merge=lfs -text
*.m4a      filter=lfs diff=lfs merge=lfs -text
*.aiff     filter=lfs diff=lfs merge=lfs -text
*.aif      filter=lfs diff=lfs merge=lfs -text
*.opus     filter=lfs diff=lfs merge=lfs -text

# --- 3D 模型（源文件不可合并，建议上锁）---
*.glb      filter=lfs diff=lfs merge=lfs -text lockable
*.gltf     filter=lfs diff=lfs merge=lfs -text lockable
*.fbx      filter=lfs diff=lfs merge=lfs -text lockable
*.obj      filter=lfs diff=lfs merge=lfs -text
*.blend    filter=lfs diff=lfs merge=lfs -text lockable
*.blend1   filter=lfs diff=lfs merge=lfs -text
*.dae      filter=lfs diff=lfs merge=lfs -text
*.stl      filter=lfs diff=lfs merge=lfs -text
*.usd      filter=lfs diff=lfs merge=lfs -text
*.usda     filter=lfs diff=lfs merge=lfs -text
*.usdc     filter=lfs diff=lfs merge=lfs -text
*.usdz     filter=lfs diff=lfs merge=lfs -text
*.abc      filter=lfs diff=lfs merge=lfs -text

# --- 视频 / 过场 ---
*.mp4      filter=lfs diff=lfs merge=lfs -text
*.mov      filter=lfs diff=lfs merge=lfs -text
*.avi      filter=lfs diff=lfs merge=lfs -text
*.webm     filter=lfs diff=lfs merge=lfs -text
*.mkv      filter=lfs diff=lfs merge=lfs -text

# ============================================================
# 注意：*.svg 是纯文本矢量图，故意【不】走 LFS，
#       这样改图标时能看到清晰的 diff，也能正常合并。
# ============================================================
