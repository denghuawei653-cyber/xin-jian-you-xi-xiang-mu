# ============================================================
# Godot 4 团队协作 .gitignore
#
# 判断标准：本机生成的 / 可以再生成的 / 含密钥的 —— 一律不入库，
#           否则团队每天都会在这些文件上产生无意义的冲突。
# ============================================================

# ---------- 1. Godot 编辑器缓存（最关键，绝不能提交）----------
# 资源导入缓存、编辑器布局、脚本类缓存、shader 缓存都在这里。
# 体积常常几百 MB，而且每台机器都不一样，一旦提交全员天天冲突。
.godot/

# ---------- 2. Godot 3 遗留目录 ----------
# 防止以后合并旧的 Godot 3 分支时把 .import/ 带进来
.import/

# ---------- 3. 自动生成的翻译资源 ----------
# 由 CSV 翻译表在导入时生成，改 CSV 就会重新生成，不必入库
*.translation

# ---------- 4. 导出产物 ----------
/build/
/builds/
/export/
/dist/
*.pck
*.exe
*.apk
*.aab
*.ipa
*.dmg

# ---------- 5. 导出 / 签名密钥，绝不入库 ----------
*.keystore
*.jks
*.p12
*.pfx
*.mobileprovision
secrets/
.env
.env.*

# ---------- 6. 编辑器 / IDE ----------
# 若团队希望共享编辑器配置，可把 .vscode/settings.json 单独白名单出来
.vscode/
.idea/
*.swp
*~

# ---------- 7. 操作系统垃圾文件 ----------
.DS_Store
._*
Thumbs.db
desktop.ini

# ============================================================
# 可选：若以后启用 Godot .NET (C#)，取消下面注释
# （.csproj / .sln 由 Godot 自动生成，不需要入库）
# ============================================================
# .mono/
# mono_crash.*.json
# *.csproj
# *.sln
# *.user

# ============================================================
# 特别说明：【这些一定要提交】，写在这里防止被上面的规则误伤
#
#   project.godot      项目配置
#   export_presets.cfg 导出预设（提交前请清掉里面的密钥！见 CONTRIBUTING.md）
#   *.tscn / *.tres    场景与资源
#   *.import           导入参数，必须提交，否则别人拉下来材质全丢
#   *.uid              Godot 4.4+ 的资源稳定 ID，必须提交
#   addons/            插件目录，必须提交
# ============================================================
